# ServiceOS API — environment template (see docs/DEVELOPMENT_SETUP.md)
# Copy to .env and replace every CHANGE_ME. NEVER commit .env.

NODE_ENV=development
PORT=4000

# --- Database roles (credential separation, audit INFRA-08) ---
DATABASE_URL=postgresql://serviceos_app:CHANGE_ME@127.0.0.1:5433/serviceos
# Owner/migration role — BYPASSRLS (FORCE RLS subjects even the table owner);
# used by `prisma migrate` and `db:seed` ONLY, never by a runtime process
DATABASE_MIGRATE_URL=postgresql://serviceos_migrate:CHANGE_ME@127.0.0.1:5433/serviceos
# Least-privilege worker role (audit SEC-03): claim/update outbox events,
# read maintenance plans + service contracts, update worker heartbeat. NOTHING else.
DATABASE_WORKER_URL=postgresql://serviceos_worker:CHANGE_ME@127.0.0.1:5433/serviceos

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- File storage (audit SEC-07 / INFRA-01) ---
# local = private on-disk dir + HMAC signed URLs (development ONLY — production boot fails)
# s3   = private bucket + presigned URLs (production)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=../../data/uploads
# S3 driver settings (required when STORAGE_DRIVER=s3)
# STORAGE_S3_BUCKET=serviceos-prod-files
# STORAGE_S3_REGION=ap-south-1
# STORAGE_S3_ENDPOINT=              # optional (MinIO/localstack testing)
# STORAGE_S3_FORCE_PATH_STYLE=false
# STORAGE_S3_KMS_KEY_ID=            # optional (SSE-KMS; default SSE-S3 AES256)
MAX_UPLOAD_MB=25

# --- Malware scanning (audit SEC-06) ---
# signature = built-in EICAR/executable detection (default)
# clamav    = clamd daemon via INSTREAM (production) — CLAMD_HOST/CLAMD_PORT
# disabled  = dev/test only — production boot fails
MALWARE_SCANNER=signature
# CLAMD_HOST=127.0.0.1
# CLAMD_PORT=3310

# --- Rate limiting (audit SEC-02) ---
# RATE_LIMITING=on                  # 'off' is a test seam only
# THROTTLE_TTL_MS=60000
# THROTTLE_LIMIT=300
# AUTH_THROTTLE_LIMIT=10
# TRUST_PROXY=loopback              # express trust proxy setting (proxy topology)

WORKER_POLL_MS=3000
LOG_LEVEL=info

# Public API base for signed URLs (defaults to APP_URL). In gateway-routed
# deployments set the gateway port parameter:
# API_PUBLIC_URL=http://localhost:3000
# API_GATEWAY_PORT=4000
