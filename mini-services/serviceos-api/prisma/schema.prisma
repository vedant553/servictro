model WorkOrder {
  id                         String          @id @default(uuid()) @db.Uuid
  tenantId                   String          @default(dbgenerated("current_setting('app.tenant_id'::text, true)::uuid")) @map("tenant_id") @db.Uuid
  workOrderNo                String          @map("work_order_no")
  requestId                  String?         @map("request_id") @db.Uuid
  customerId                 String          @map("customer_id") @db.Uuid
  siteId                     String          @map("site_id") @db.Uuid
  assetId                    String?         @map("asset_id") @db.Uuid
  title                      String
  description                String?
  type                       WorkOrderType   @default(breakdown)
  status                     WorkOrderStatus @default(draft)
  priority                   Priority        @default(normal)
  scheduledStartAt           DateTime?       @map("scheduled_start_at") @db.Timestamptz(6)
  scheduledEndAt             DateTime?       @map("scheduled_end_at") @db.Timestamptz(6)
  responseDueAt              DateTime?       @map("response_due_at") @db.Timestamptz(6)
  resolutionDueAt            DateTime?       @map("resolution_due_at") @db.Timestamptz(6)
  slaPolicy                  Json?
  checklistTemplateVersionId String?         @map("checklist_template_version_id") @db.Uuid
  requiredSkills             String[]        @default([]) @map("required_skills")
  completionSummary          String?         @map("completion_summary")
  cancelledReason            String?         @map("cancelled_reason")
  completedAt                DateTime?       @map("completed_at") @db.Timestamptz(6)
  closedAt                   DateTime?       @map("closed_at") @db.Timestamptz(6)
  version                    Int             @default(1)
  createdById                String?         @map("created_by_id") @db.Uuid
  createdAt                  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  request                  ServiceRequest?           @relation(fields: [tenantId, requestId], references: [tenantId, id])
  customer                 CustomerAccount           @relation(fields: [tenantId, customerId], references: [tenantId, id])
  site                     Site                      @relation(fields: [tenantId, siteId], references: [tenantId, id])
  asset                    Asset?                    @relation(fields: [tenantId, assetId], references: [tenantId, id])
  checklistTemplateVersion ChecklistTemplateVersion? @relation(fields: [tenantId, checklistTemplateVersionId], references: [tenantId, id])
  assignments              WorkOrderAssignment[]
  events                   WorkOrderEvent[]
  checklistResults         ChecklistResult[]
  measurements             ServiceMeasurement[]
  observations             ServiceObservation[]
  partsUsage               PartUsage[]
  serviceReports           ServiceReport[]
  plannedVisit             PlannedVisit?

  @@unique([tenantId, id])
  @@unique([tenantId, workOrderNo])
  @@index([tenantId, status, createdAt(sort: Desc)])
  @@index([tenantId, resolutionDueAt])
  @@index([tenantId, customerId])
  @@index([tenantId, siteId])
  @@index([tenantId, assetId])
  @@map("work_orders")
}

