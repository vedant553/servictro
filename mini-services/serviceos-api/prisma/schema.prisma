// ---------------------------------------------------------------------------
// Notifications, audit, outbox, idempotency, mobile sync (RLS-protected)
// ---------------------------------------------------------------------------

model Notification {
  id         String               @id @default(uuid()) @db.Uuid
  tenantId   String               @default(dbgenerated("current_setting('app.tenant_id'::text, true)::uuid")) @map("tenant_id") @db.Uuid
  userId     String               @map("user_id") @db.Uuid
  category   NotificationCategory
  title      String
  body       String
  entityType String?              @map("entity_type")
  entityId   String?              @map("entity_id") @db.Uuid
  link       String?
  /** Stable deduplication key (e.g. amc_renewal:{contractId}:{days}) — unique per user; prevents repeat reminders. */
  dedupKey   String?              @map("dedup_key")
  readAt     DateTime?            @map("read_at") @db.Timestamptz(6)
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  deliveries NotificationDelivery[]

  @@unique([tenantId, id])
  @@index([tenantId, userId, readAt])
  @@index([tenantId, userId, dedupKey])
  @@map("notifications")
}

model NotificationDelivery {
  id                String          @id @default(uuid()) @db.Uuid
  tenantId          String          @default(dbgenerated("current_setting('app.tenant_id'::text, true)::uuid")) @map("tenant_id") @db.Uuid
  notificationId    String          @map("notification_id") @db.Uuid
  channel           DeliveryChannel
  status            DeliveryStatus  @default(pending)
  providerMessageId String?         @map("provider_message_id")
  error             String?
  attemptedAt       DateTime        @default(now()) @map("attempted_at") @db.Timestamptz(6)

  notification Notification @relation(fields: [tenantId, notificationId], references: [tenantId, id])

  @@index([tenantId, notificationId])
  @@map("notification_deliveries")
}

model AuditEvent {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @default(dbgenerated("current_setting('app.tenant_id'::text, true)::uuid")) @map("tenant_id") @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  action       String
  resourceType String   @map("resource_type")
  resourceId   String   @map("resource_id") @db.Uuid
  reason       String?
  requestId    String?  @map("request_id")
  ipHash       String?  @map("ip_hash")
  metadata     Json     @default("{}")
  occurredAt   DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@unique([tenantId, id])
  @@index([tenantId, resourceType, resourceId, occurredAt(sort: Desc)])
  @@index([tenantId, actorUserId, occurredAt(sort: Desc)])
  @@map("audit_events")
}

model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @default(dbgenerated("current_setting('app.tenant_id'::text, true)::uuid")) @map("tenant_id") @db.Uuid
  eventType     String    @map("event_type")
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id") @db.Uuid
  payload       Json      @default("{}")
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  /** Claim lease (DATA-06): SKIP LOCKED claim + expiry lease for multi-instance workers. */
  lockedUntil   DateTime? @map("locked_until") @db.Timestamptz(6)
  lockedBy      String?   @map("locked_by")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, id])
  @@index([publishedAt, createdAt])
  @@index([publishedAt, attempts, lockedUntil])
  @@map("outbox_events")
}

model IdempotencyKey {
  tenantId       String   @default(dbgenerated("current_setting('app.tenant_id'::text, true)::uuid")) @map("tenant_id") @db.Uuid
  key            String
  requestHash    String   @map("request_hash")
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([tenantId, key])
  @@map("idempotency_keys")
}

model MobileSyncOperation {
  tenantId        String   @default(dbgenerated("current_setting('app.tenant_id'::text, true)::uuid")) @map("tenant_id") @db.Uuid
  operationId     String   @map("operation_id") @db.Uuid
  deviceId        String   @map("device_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  entityType      String   @map("entity_type")
  entityId        String   @map("entity_id") @db.Uuid
  result          String
  serverVersion   Int?     @map("server_version")
  responsePayload Json?    @map("response_payload")
  receivedAt      DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  @@id([tenantId, operationId])
  @@index([tenantId, userId])
  @@index([userId, receivedAt])
  @@map("mobile_sync_operations")
}

// ---------------------------------------------------------------------------
// Worker heartbeat (monitoring — audit INFRA-07). Platform-scope table (no
// tenant_id, no RLS): a single singleton row the worker updates and
// /health/worker reports. Written by the least-privilege worker role.
// ---------------------------------------------------------------------------
model WorkerHeartbeat {
  id                String   @id @default("singleton")
  workerId          String   @map("worker_id")
  lastOutboxPollAt  DateTime? @map("last_outbox_poll_at") @db.Timestamptz(6)
  lastPmPassAt      DateTime? @map("last_pm_pass_at") @db.Timestamptz(6)
  lastRenewalPassAt DateTime? @map("last_renewal_pass_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("worker_heartbeats")
}
