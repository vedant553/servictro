// ---------------------------------------------------------------------------
// Identity & tenancy (platform scope — NO row-level security)
// ---------------------------------------------------------------------------

model Tenant {
  id                 String       @id @default(uuid()) @db.Uuid
  slug               String       @unique
  name               String
  legalName          String?      @map("legal_name")
  timezone           String       @default("Asia/Kolkata")
  locale             String       @default("en-IN")
  currencyCode       String       @default("INR") @map("currency_code") @db.Char(3)
  status             TenantStatus @default(active)
  plan               String       @default("trial")
  subscriptionStatus String       @default("trialing") @map("subscription_status")
  settings           Json         @default("{}")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships        Membership[]
  invitations        Invitation[]
  numberSequences    NumberSequence[]
  customers          CustomerAccount[]
  attachments        Attachment[]
  checklistTemplates ChecklistTemplate[]

  // Plain tenant_id → tenants(id FKs for every other tenant-owned table are
  // added in the reviewed SQL migration (see prisma/migrations), mirroring the
  // engineering spec's DDL. Prisma relations are declared only where the
  // object graph needs navigation.
  @@map("tenants")
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique
  displayName     String     @map("display_name")
  phone           String?
  passwordHash    String?    @map("password_hash")
  status          UserStatus @default(active)
  identityIssuer  String?    @map("identity_issuer")
  identitySubject String?    @map("identity_subject")
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships   Membership[]
  refreshTokens RefreshToken[]
  assignments   WorkOrderAssignment[]

  @@unique([identityIssuer, identitySubject])
  @@map("users")
}

model Membership {
  tenantId  String           @map("tenant_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  role      Role
  status    MembershipStatus @default(invited)
  title     String?
  skills    String[]         @default([])
  invitedBy String?          @map("invited_by") @db.Uuid
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@id([tenantId, userId])
  @@index([userId])
  @@map("tenant_memberships")
}

model Invitation {
  id               String           @id @default(uuid()) @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  email            String
  role             Role
  tokenHash        String           @unique @map("token_hash")
  status           InvitationStatus @default(pending)
  invitedById      String?          @map("invited_by_id") @db.Uuid
  expiresAt        DateTime         @map("expires_at") @db.Timestamptz(6)
  acceptedAt       DateTime?        @map("accepted_at") @db.Timestamptz(6)
  acceptedByUserId String?          @map("accepted_by_user_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status])
  @@map("invitations")
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

model NumberSequence {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text, true)::uuid")) @map("tenant_id") @db.Uuid
  key       String
  nextValue Int      @default(1) @map("next_value")
  prefix    String   @default("")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@map("number_sequences")
}

// ---------------------------------------------------------------------------
// CRM: customers, contacts, sites, assets  (RLS-protected)
// ---------------------------------------------------------------------------

model CustomerAccount {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @default(dbgenerated("current_setting('app.tenant_id'::text, true)::uuid")) @map("tenant_id") @db.Uuid
  accountCode    String         @map("account_code")
  legalName      String         @map("legal_name")
  segment        String?
  status         CustomerStatus @default(active)
  billingAddress Json           @default("{}") @map("billing_address")
  notes          String?
  version        Int            @default(1)
  deletedAt      DateTime?      @map("deleted_at") @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  contacts   CustomerContact[]
  sites      Site[]
  contracts  ServiceContract[]
  requests   ServiceRequest[]
  workOrders WorkOrder[]

  @@unique([tenantId, id])
  @@unique([tenantId, accountCode])
  @@index([tenantId, status, createdAt(sort: Desc)])
  @@map("customer_accounts")
}

model CustomerContact {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @default(dbgenerated("current_setting('app.tenant_id'::text, true)::uuid")) @map("tenant_id") @db.Uuid
  customerId String    @map("customer_id") @db.Uuid
  name       String
  role       String?
  email      String?
  phone      String?
  isPrimary  Boolean   @default(false) @map("is_primary")
  notes      String?
  version    Int       @default(1)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer CustomerAccount @relation(fields: [tenantId, customerId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@index([tenantId, customerId])
  @@map("customer_contacts")
}

model Site {
  id                 String     @id @default(uuid()) @db.Uuid
  tenantId           String     @default(dbgenerated("current_setting('app.tenant_id'::text, true)::uuid")) @map("tenant_id") @db.Uuid
  customerId         String     @map("customer_id") @db.Uuid
  siteCode           String     @map("site_code")
  name               String
  status             SiteStatus @default(active)
  address            Json       @default("{}")
  latitude           Decimal?   @db.Decimal(9, 6)
  longitude          Decimal?   @db.Decimal(9, 6)
  timezone           String     @default("Asia/Kolkata")
  accessInstructions String?    @map("access_instructions")
  operatingHours     Json?      @map("operating_hours")
  version            Int        @default(1)
  deletedAt          DateTime?  @map("deleted_at") @db.Timestamptz(6)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer   CustomerAccount  @relation(fields: [tenantId, customerId], references: [tenantId, id])
  assets     Asset[]
  requests   ServiceRequest[]
  workOrders WorkOrder[]

  @@unique([tenantId, id])
  @@unique([tenantId, siteCode])
  @@index([tenantId, customerId])
  @@map("sites")
}

model Asset {
  id                         String      @id @default(uuid()) @db.Uuid
  tenantId                   String      @default(dbgenerated("current_setting('app.tenant_id'::text, true)::uuid")) @map("tenant_id") @db.Uuid
  siteId                     String      @map("site_id") @db.Uuid
  parentAssetId              String?     @map("parent_asset_id") @db.Uuid
  assetCode                  String      @map("asset_code")
  serialNumber               String?     @map("serial_number")
  assetFamily                AssetFamily @map("asset_family")
  manufacturer               String?
  model                      String?
  commissioningDate          DateTime?   @map("commissioning_date") @db.Date
  specificationSchemaVersion Int         @default(1) @map("specification_schema_version")
  specification              Json        @default("{}")
  status                     AssetStatus @default(active)
  notes                      String?
  version                    Int         @default(1)
  deletedAt                  DateTime?   @map("deleted_at") @db.Timestamptz(6)
  createdAt                  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent          Asset?                 @relation("AssetHierarchy", fields: [tenantId, parentAssetId], references: [tenantId, id])
  children        Asset[]                @relation("AssetHierarchy")
  site            Site                   @relation(fields: [tenantId, siteId], references: [tenantId, id])
  documents       AssetDocument[]
  contractAssets  ContractAsset[]
  requests        ServiceRequest[]
  workOrders      WorkOrder[]
  measurements    ServiceMeasurement[]
  plannedVisits   PlannedVisit[]
  planMemberships MaintenancePlanAsset[]

  @@unique([tenantId, id])
  @@unique([tenantId, assetCode])
  @@index([tenantId, siteId])
  @@index([tenantId, assetFamily])
  @@index([tenantId, serialNumber])
  @@map("assets")
}

model Attachment {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @default(dbgenerated("current_setting('app.tenant_id'::text, true)::uuid")) @map("tenant_id") @db.Uuid
  objectKey      String           @unique @map("object_key")
  originalName   String           @map("original_name")
  contentType    String           @map("content_type")
  sizeBytes      BigInt           @map("size_bytes")
  checksumSha256 String           @map("checksum_sha256")
  scanStatus     ScanStatus       @default(pending) @map("scan_status")
  status         AttachmentStatus @default(pending)
  ownerType      String?          @map("owner_type")
  ownerId        String?          @map("owner_id") @db.Uuid
  uploadedById   String?          @map("uploaded_by_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant                  Tenant          @relation(fields: [tenantId], references: [id])
  assetDocuments          AssetDocument[]
  serviceReportsGenerated ServiceReport[] @relation("ReportGeneratedAttachment")
  serviceReportsSigned    ServiceReport[] @relation("ReportSignatureAttachment")

  @@unique([tenantId, id])
  @@index([tenantId, ownerType, ownerId])
  @@map("attachments")
}

model AssetDocument {
  id           String            @id @default(uuid()) @db.Uuid
  tenantId     String            @default(dbgenerated("current_setting('app.tenant_id'::text, true)::uuid")) @map("tenant_id") @db.Uuid
  assetId      String            @map("asset_id") @db.Uuid
  attachmentId String            @map("attachment_id") @db.Uuid
  documentType AssetDocumentType @map("document_type")
  title        String?
  revision     String?
  notes        String?
  uploadedById String?           @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  asset      Asset      @relation(fields: [tenantId, assetId], references: [tenantId, id])
  attachment Attachment @relation(fields: [tenantId, attachmentId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@index([tenantId, assetId])
  @@map("asset_documents")
}

// ---------------------------------------------------------------------------
// Contracts & maintenance
// ---------------------------------------------------------------------------

model ServiceContract {
  id                      String         @id @default(uuid()) @db.Uuid
  tenantId                String         @default(dbgenerated("current_setting('app.tenant_id'::text, true)::uuid")) @map("tenant_id") @db.Uuid
  customerId              String         @map("customer_id") @db.Uuid
  contractNo              String         @map("contract_no")
  contractType            ContractType   @map("contract_type")
  status                  ContractStatus @default(draft)
  startDate               DateTime       @map("start_date") @db.Date
  endDate                 DateTime       @map("end_date") @db.Date
  currencyCode            String         @default("INR") @map("currency_code") @db.Char(3)
  amountMinor             BigInt?        @map("amount_minor")
  responseTargetMinutes   Int?           @map("response_target_minutes")
  resolutionTargetMinutes Int?           @map("resolution_target_minutes")
  includedVisitsPerYear   Int?           @map("included_visits_per_year")
  terms                   Json           @default("{}")
  renewalStatus           RenewalStatus  @default(not_due) @map("renewal_status")
  renewalNotes            String?        @map("renewal_notes")
  version                 Int            @default(1)
  deletedAt               DateTime?      @map("deleted_at") @db.Timestamptz(6)
  createdAt               DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer         CustomerAccount   @relation(fields: [tenantId, customerId], references: [tenantId, id])
  assets           ContractAsset[]
  maintenancePlans MaintenancePlan[]

  @@unique([tenantId, id])
  @@unique([tenantId, contractNo])
  @@index([tenantId, status, endDate])
  @@map("service_contracts")
}

model ContractAsset {
  tenantId       String       @default(dbgenerated("current_setting('app.tenant_id'::text, true)::uuid")) @map("tenant_id") @db.Uuid
  contractId     String       @map("contract_id") @db.Uuid
  assetId        String       @map("asset_id") @db.Uuid
  coverageType   CoverageType @default(full) @map("coverage_type")
  includedVisits Int?         @map("included_visits")
  notes          String?
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  contract ServiceContract @relation(fields: [tenantId, contractId], references: [tenantId, id])
  asset    Asset           @relation(fields: [tenantId, assetId], references: [tenantId, id])

  @@id([tenantId, contractId, assetId])
  @@map("contract_assets")
}

model MaintenancePlan {
  id                  String      @id @default(uuid()) @db.Uuid
  tenantId            String      @default(dbgenerated("current_setting('app.tenant_id'::text, true)::uuid")) @map("tenant_id") @db.Uuid
  contractId          String?     @map("contract_id") @db.Uuid
  planCode            String      @map("plan_code")
  name                String
  assetFamily         AssetFamily @map("asset_family")
  recurrence          Json
  timezone            String      @default("Asia/Kolkata")
  startDate           DateTime    @map("start_date") @db.Date
  endDate             DateTime?   @map("end_date") @db.Date
  horizonDays         Int         @default(90) @map("horizon_days")
  leadDays            Int         @default(14) @map("lead_days")
  checklistTemplateId String?     @map("checklist_template_id") @db.Uuid
  status              PlanStatus  @default(draft)
  version             Int         @default(1)
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  contract          ServiceContract?       @relation(fields: [tenantId, contractId], references: [tenantId, id])
  checklistTemplate ChecklistTemplate?     @relation(fields: [tenantId, checklistTemplateId], references: [tenantId, id])
  assets            MaintenancePlanAsset[]
  plannedVisits     PlannedVisit[]

  @@unique([tenantId, id])
  @@unique([tenantId, planCode])
  @@map("maintenance_plans")
}

model MaintenancePlanAsset {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id'::text, true)::uuid")) @map("tenant_id") @db.Uuid
  planId    String   @map("plan_id") @db.Uuid
  assetId   String   @map("asset_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  plan  MaintenancePlan @relation(fields: [tenantId, planId], references: [tenantId, id])
  asset Asset           @relation(fields: [tenantId, assetId], references: [tenantId, id])

  @@id([tenantId, planId, assetId])
  @@map("maintenance_plan_assets")
}

model PlannedVisit {
  id            String             @id @default(uuid()) @db.Uuid
  tenantId      String             @default(dbgenerated("current_setting('app.tenant_id'::text, true)::uuid")) @map("tenant_id") @db.Uuid
  planId        String             @map("plan_id") @db.Uuid
  assetId       String             @map("asset_id") @db.Uuid
  dueAt         DateTime           @map("due_at") @db.Timestamptz(6)
  status        PlannedVisitStatus @default(planned)
  workOrderId   String?            @map("work_order_id") @db.Uuid
  generationKey String             @unique @map("generation_key")
  completedAt   DateTime?          @map("completed_at") @db.Timestamptz(6)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  plan      MaintenancePlan @relation(fields: [tenantId, planId], references: [tenantId, id])
  asset     Asset           @relation(fields: [tenantId, assetId], references: [tenantId, id])
  workOrder WorkOrder?      @relation(fields: [tenantId, workOrderId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@unique([tenantId, workOrderId])
  @@index([tenantId, status, dueAt])
  @@map("planned_visits")
}

// ---------------------------------------------------------------------------
// Service desk & work management
// ---------------------------------------------------------------------------

model ServiceRequest {
  id               String          @id @default(uuid()) @db.Uuid
  tenantId         String          @default(dbgenerated("current_setting('app.tenant_id'::text, true)::uuid")) @map("tenant_id") @db.Uuid
  requestNo        String          @map("request_no")
  customerId       String          @map("customer_id") @db.Uuid
  siteId           String          @map("site_id") @db.Uuid
  assetId          String?         @map("asset_id") @db.Uuid
  contactId        String?         @map("contact_id") @db.Uuid
  source           RequestSource
  category         RequestCategory @default(other)
  subject          String
  description      String
  severity         Severity        @default(medium)
  status           RequestStatus   @default(new)
  preferredVisitAt DateTime?       @map("preferred_visit_at") @db.Timestamptz(6)
  firstResponseAt  DateTime?       @map("first_response_at") @db.Timestamptz(6)
  triagedAt        DateTime?       @map("triaged_at") @db.Timestamptz(6)
  triagedById      String?         @map("triaged_by_id") @db.Uuid
  acceptedAt       DateTime?       @map("accepted_at") @db.Timestamptz(6)
  rejectedReason   String?         @map("rejected_reason")
  convertedAt      DateTime?       @map("converted_at") @db.Timestamptz(6)
  closedAt         DateTime?       @map("closed_at") @db.Timestamptz(6)
  createdById      String          @map("created_by_id") @db.Uuid
  version          Int             @default(1)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer   CustomerAccount @relation(fields: [tenantId, customerId], references: [tenantId, id])
  site       Site            @relation(fields: [tenantId, siteId], references: [tenantId, id])
  asset      Asset?          @relation(fields: [tenantId, assetId], references: [tenantId, id])
  workOrders WorkOrder[]

  @@unique([tenantId, id])
