// ServiceOS — PostgreSQL schema (Tech Spec §11 + Appendix A baseline).
// Conventions: snake_case tables/columns via @map/@@map, UUID ids, tenant_id on
// every tenant-owned row, composite FKs (tenant_id, child) -> (tenant_id, id),
// timestamptz UTC, optimistic-concurrency `version` columns on aggregate roots.
// CHECK constraints, partial indexes, RLS policies and role grants live in
// reviewed SQL migrations (see prisma/migrations).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // app role (serviceos_app) — RLS applies
  directUrl = env("DATABASE_MIGRATE_URL") // owner/migration role — RLS bypassed
}

// ---------------------------------------------------------------------------
// Enums (lower_snake_case values in DB — Tech Spec §5.2)
// ---------------------------------------------------------------------------

